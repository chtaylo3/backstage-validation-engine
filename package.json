{
  "name": "@chtaylo3/backstage-validation-engine",
  "version": "0.1.0-dev.0",
  "description": "Shared, source-preserving Backstage catalog validation contracts and engine foundations",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chtaylo3/backstage-validation-engine.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./schemas/*": "./schemas/*.schema.json",
    "./lsp": {
      "types": "./dist/lsp/index.d.ts",
      "import": "./dist/lsp/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:compile && node scripts/test.mjs",
    "test:harness": "npm run test:compile && node scripts/test.mjs --group engine --group lsp --group tooling",
    "fixtures:refresh": "tsc -p tsconfig.test.json && node .test-dist/test/harness/refresh-cli.js",
    "fixtures:check-upstream": "tsc -p tsconfig.test.json && node .test-dist/test/harness/refresh-cli.js --check",
    "fixtures:serve": "tsc -p tsconfig.test.json && node .test-dist/test/harness/serve-cli.js",
    "test:coverage": "npm run test:compile && node scripts/test.mjs --coverage",
    "schemas:generate": "npm run build && node scripts/schemas.mjs",
    "schemas:check": "npm run build && node scripts/schemas.mjs --check",
    "benchmark:cel": "npm run build && node scripts/benchmark-cel.mjs",
    "example:cel": "npm run build && node examples/run-cel-rules.mjs",
    "example:parse": "npm run build && node examples/parse-catalog.mjs",
    "example:backstage": "npm run build && node examples/validate-backstage.mjs",
    "example:custom": "npm run build && node examples/validate-custom-kind.mjs",
    "example:overlay": "npm run build && node examples/validate-overlay.mjs",
    "example:provider": "npm run build && node examples/read-catalog.mjs",
    "example:references": "npm run build && node examples/prepare-references.mjs",
    "jetbrains:template": "npm run build && node scripts/jetbrains-template.mjs",
    "check": "npm run architecture:check && npm run typecheck && npm run lint && npm run format:check && npm run schemas:check && npm test && node scripts/test-client.mjs",
    "test:lsp": "npm run test:compile && node scripts/test.mjs --group engine --group lsp",
    "example:cli": "npm run build && node examples/create-cli-release.mjs",
    "test:compile": "node scripts/clean.mjs tests && tsc -p tsconfig.test.json",
    "test:packaged": "npm run test:compile && node scripts/test.mjs --packaged",
    "extension:package": "npm run build && node scripts/package-extension.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:extension:verify": "node scripts/test-extension.mjs --verify-failures",
    "test:extension:cli": "node --throw-deprecation scripts/test-extension-cli.mjs",
    "test:client": "npm run test:compile && node scripts/test-client.mjs",
    "test:extension:races": "node scripts/test-extension.mjs --races",
    "test:extension:compatibility": "node scripts/test-extension.mjs --compat",
    "test:extension:load": "node scripts/test-extension.mjs --endurance",
    "test:extension:soak": "node scripts/test-extension.mjs --soak",
    "test:extension:remote": "node scripts/test-extension-remote.mjs",
    "test:extension:ssh-network": "node scripts/test-ssh-network.mjs",
    "test:extension:qualification": "node scripts/verify-extension-qualification.mjs",
    "cli:package": "npm run build && node scripts/package-cli.mjs",
    "backstage:test:check": "node scripts/backstage-test-env.mjs check",
    "backstage:test:build": "node scripts/backstage-test-env.mjs build",
    "backstage:test:up": "node scripts/backstage-test-env.mjs up",
    "backstage:test:status": "node scripts/backstage-test-env.mjs status",
    "backstage:test:seed": "node scripts/backstage-test-env.mjs seed",
    "backstage:test:reset": "node scripts/backstage-test-env.mjs reset",
    "backstage:test:down": "node scripts/backstage-test-env.mjs down",
    "backstage:test:clean": "node scripts/backstage-test-env.mjs clean",
    "backstage:test:editor": "node scripts/backstage-test-env.mjs editor",
    "test:backstage:development": "node scripts/backstage-test-env.mjs development",
    "test:backstage:release": "node scripts/backstage-test-env.mjs release",
    "architecture:check": "node scripts/architecture-boundaries.mjs",
    "test:cel-go": "npm run test:compile && node scripts/compare-cel-go.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "vscode-languageclient": {
      "minimatch": "5.1.9"
    }
  },
  "dependencies": {
    "@backstage/catalog-model": "1.10.2",
    "@marcbachmann/cel-js": "https://codeload.github.com/chtaylo3/cel-js/tar.gz/2af49f7b595368d031403de04d5b6f777b7d53d4",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "backstage-catalog-model-older": "npm:@backstage/catalog-model@1.7.5",
    "re2js": "2.9.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/vscode": "1.145.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vscode-languageclient": "11.0.0",
    "yauzl": "3.4.0"
  },
  "bin": {
    "bve-lsp": "./dist/lsp/stdio.js",
    "bve": "./dist/cli/main.js"
  }
}
