{
  "name": "@chtaylo3/backstage-validation-engine",
  "version": "0.1.0-dev.0",
  "description": "Shared, source-preserving Backstage catalog validation contracts and engine foundations",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chtaylo3/backstage-validation-engine.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./schemas/*": "./schemas/*.schema.json",
    "./lsp": {
      "types": "./dist/lsp/index.d.ts",
      "import": "./dist/lsp/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:compile && node scripts/test.mjs",
    "test:harness": "node scripts/clean.mjs tests && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=30000 .test-dist/test/fixture-matrix.test.js .test-dist/test/catalog-api.test.js .test-dist/test/catalog-provider.test.js .test-dist/test/backstage-references.test.js .test-dist/test/release-refresh.test.js .test-dist/test/catalog-rules.test.js .test-dist/test/lsp.test.js .test-dist/test/lsp-filesystem.test.js .test-dist/test/filesystem-source.test.js .test-dist/test/lsp-filesystem-budget.test.js .test-dist/test/scalar-fixes.test.js .test-dist/test/lsp-fixes.test.js .test-dist/test/lsp-fixes-integration.test.js .test-dist/test/catalog-suggestions.test.js .test-dist/test/completion.test.js .test-dist/test/lsp-completion.test.js",
    "fixtures:refresh": "tsc -p tsconfig.test.json && node .test-dist/test/harness/refresh-cli.js",
    "fixtures:check-upstream": "tsc -p tsconfig.test.json && node .test-dist/test/harness/refresh-cli.js --check",
    "fixtures:serve": "tsc -p tsconfig.test.json && node .test-dist/test/harness/serve-cli.js",
    "test:coverage": "npm run test:compile && node scripts/test.mjs --coverage",
    "schemas:generate": "npm run build && node scripts/schemas.mjs",
    "schemas:check": "npm run build && node scripts/schemas.mjs --check",
    "benchmark:cel": "npm run build && node scripts/benchmark-cel.mjs",
    "example:cel": "npm run build && node examples/run-cel-rules.mjs",
    "example:parse": "npm run build && node examples/parse-catalog.mjs",
    "example:backstage": "npm run build && node examples/validate-backstage.mjs",
    "example:custom": "npm run build && node examples/validate-custom-kind.mjs",
    "example:overlay": "npm run build && node examples/validate-overlay.mjs",
    "example:provider": "npm run build && node examples/read-catalog.mjs",
    "example:references": "npm run build && node examples/prepare-references.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run schemas:check && npm test",
    "test:lsp": "node scripts/clean.mjs tests && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=30000 .test-dist/test/catalog-rules.test.js .test-dist/test/lsp.test.js .test-dist/test/lsp-filesystem.test.js .test-dist/test/filesystem-source.test.js .test-dist/test/lsp-filesystem-budget.test.js .test-dist/test/scalar-fixes.test.js .test-dist/test/lsp-fixes.test.js .test-dist/test/lsp-fixes-integration.test.js .test-dist/test/catalog-suggestions.test.js .test-dist/test/completion.test.js .test-dist/test/lsp-completion.test.js",
    "example:cli": "npm run build && node examples/create-cli-release.mjs",
    "test:compile": "node scripts/clean.mjs tests && tsc -p tsconfig.test.json",
    "test:packaged": "npm run test:compile && node scripts/test.mjs --packaged",
    "extension:package": "npm run build && node scripts/package-extension.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:extension:verify": "node scripts/test-extension.mjs --verify-failures",
    "test:client": "npm run test:compile && node scripts/test-client.mjs",
    "test:extension:races": "node scripts/test-extension.mjs --races",
    "test:extension:compatibility": "node scripts/test-extension.mjs --compat",
    "test:extension:load": "node scripts/test-extension.mjs --endurance",
    "test:extension:soak": "node scripts/test-extension.mjs --soak",
    "test:extension:remote": "node scripts/test-extension-remote.mjs",
    "test:extension:qualification": "node scripts/verify-extension-qualification.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "vscode-languageclient": {
      "minimatch": "5.1.9"
    }
  },
  "dependencies": {
    "@backstage/catalog-model": "1.10.2",
    "@marcbachmann/cel-js": "8.0.0",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "backstage-catalog-model-older": "npm:@backstage/catalog-model@1.7.5",
    "re2js": "2.9.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/vscode": "1.145.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vscode-languageclient": "11.0.0",
    "yauzl": "3.4.0"
  },
  "bin": {
    "bve-lsp": "./dist/lsp/stdio.js",
    "bve": "./dist/cli/main.js"
  }
}
