@@ -0,0 +1,64 @@
+// OIDC PHASE 1 FEASIBILITY PROBE. THROWAWAY: never merge.
+// V3: the server receives a value on its fourth pipe, at start and after a restart, and the
+// client keeps `serverProcess`. Lengths and digests only; the value is synthetic.
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import * as vscode from 'vscode';
+import { exited, until } from '../fixture.js';
+import type { Fixture } from '../fixture.js';
+
+interface Probe {
+  pipes(): { pid: number | undefined; bytes: number; sha256: string }[];
+  clientServerProcessPid(): number | null;
+}
+const directory = () => process.env.BVE_EXTENSION_TEST_CONTROL_DIRECTORY!;
+async function received(pid: number) {
+  let row: { pid: number; bytes: number; sha256: string; runtime: string } | undefined;
+  await until(async () => {
+    row = await readFile(path.join(directory(), `probe-fd3-${pid}.json`), 'utf8')
+      .then((text) => JSON.parse(text) as typeof row)
+      .catch(() => undefined);
+    return !!row;
+  }, 'the server records the value of its fourth pipe');
+  return row!;
+}
+export async function run(fixture: Fixture): Promise<void> {
+  const probe = (fixture.api as unknown as { probe: Probe }).probe;
+  assert(probe, 'Run the probe build.');
+  const sessions = [];
+  for (let stage = 0; stage < 2; stage++) {
+    const pid = fixture.pid();
+    const sent = probe.pipes().find((row) => row.pid === pid);
+    assert(sent, 'The client records the pipe it wrote for this server process.');
+    const got = await received(pid);
+    sessions.push({
+      stage: stage === 0 ? 'start' : 'restart',
+      serverProcessPid: pid,
+      clientServerProcessPid: probe.clientServerProcessPid(),
+      sentBytes: sent.bytes,
+      receivedBytes: got.bytes,
+      digestsMatch: got.sha256 === sent.sha256,
+      serverRuntime: got.runtime,
+    });
+    await fixture.document();
+    await fixture.diagnostic();
+    if (stage === 0) {
+      await vscode.commands.executeCommand('backstageValidation.restart');
+      await until(() => fixture.api!.status().running && fixture.pid() !== pid, 'restart');
+      await until(() => exited(pid), 'previous server exits');
+    }
+  }
+  const observation = {
+    question: 'V3',
+    platform: process.platform,
+    editorVersion: vscode.version,
+    sessions,
+  };
+  await writeFile(
+    path.join(directory(), 'probe-pipe-observation.json'),
+    JSON.stringify(observation, null, 2) + '\n',
+  );
+  console.log('BVE_PROBE_OBSERVATION ' + JSON.stringify(observation));
+  for (const row of sessions) assert(row.digestsMatch, 'The server receives the value unchanged.');
+}
