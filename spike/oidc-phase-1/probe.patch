+// OIDC PHASE 1 FEASIBILITY PROBE. THROWAWAY: never merge.
+// V1 (and V5 with BVE_PROBE_OPEN_MODE=open-command): does a vscode:// link reach the product's
+// URI handler? The host tries several ways to call the editor's CLI, each with its own link, and
+// the case records for each one the host's CLI evidence and the deliveries. It also records the
+// editor's main-process and extension-host log lines about links, so that a failure says why.
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { readFile, readdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { setTimeout as pause } from 'node:timers/promises';
+import * as vscode from 'vscode';
+import type { Fixture } from '../fixture.js';
+import { openUrl } from '../links.js';
+import type { OpenUrlOptions } from '../links.js';
+
+interface Probe {
+  uris(): { uri: string; at: number; remoteName: string | null; extensionHostPid: number }[];
+  externalUri(): Promise<string>;
+}
+async function logLines() {
+  const root = path.join(process.env.BVE_EXTENSION_TEST_PROFILE!, 'logs');
+  const sessions = (await readdir(root).catch(() => [])).sort();
+  const rows: Record<string, string[]> = { sessions };
+  const latest = sessions.at(-1);
+  if (!latest) return rows;
+  const pick = async (file: string) =>
+    (await readFile(path.join(root, latest, file), 'utf8').catch(() => ''))
+      .split('\n')
+      .filter((line) => /url|uri|open|instance|launch|protocol|error/iu.test(line))
+      .filter((line) => !/policy|File Watcher/u.test(line))
+      .map((line) => line.replace(/probe=[0-9a-f-]+/gu, 'probe=<nonce>').slice(0, 300))
+      .slice(-40);
+  rows.main = await pick('main.log');
+  rows.exthost = await pick('window1/exthost/exthost.log');
+  rows.renderer = await pick('window1/renderer.log');
+  return rows;
+}
+export async function run(fixture: Fixture): Promise<void> {
+  const probe = (fixture.api as unknown as { probe: Probe }).probe;
+  assert(probe, 'Run the probe build.');
+  const mode = process.env.BVE_PROBE_OPEN_MODE ?? 'open-url';
+  const variants: { name: string; options: OpenUrlOptions & { timeoutMs?: number } }[] =
+    mode === 'open-command'
+      ? [{ name: 'macOS open command', options: {} }]
+      : [
+          { name: 'harness default (--no-sandbox)', options: { timeoutMs: 20_000 } },
+          { name: 'sandboxed, --verbose', options: { noSandbox: false, verbose: true, timeoutMs: 20_000 } },
+          { name: '--no-sandbox --verbose', options: { verbose: true, timeoutMs: 20_000 } },
+          {
+            name: '--no-sandbox --verbose --open-url -- <link>',
+            options: { verbose: true, separator: true, timeoutMs: 20_000 },
+          },
+        ];
+  const attempts = [];
+  for (const variant of variants) {
+    const nonce = randomUUID();
+    const url = `vscode://chtaylo3.backstage-validation-engine/sign-in?probe=${nonce}`;
+    const started = Date.now();
+    const answer = await openUrl(url, variant.options).catch((error: unknown) => ({
+      id: 'none',
+      status: 'failed' as const,
+      error: error instanceof Error ? error.message : String(error),
+    }));
+    const end = Date.now() + 10_000;
+    while (Date.now() < end && !probe.uris().some((row) => row.uri.includes(nonce))) await pause(100);
+    const rows = probe.uris().filter((row) => row.uri.includes(nonce));
+    attempts.push({
+      variant: variant.name,
+      hostStatus: answer.status,
+      hostError: answer.error ?? null,
+      cli: 'cli' in answer ? answer.cli : null,
+      deliveries: rows.length,
+      firstDeliveryMs: rows[0] ? rows[0].at - started : null,
+      deliveredQueryUnchanged: rows[0] ? rows[0].uri === url : null,
+    });
+  }
+  await pause(2000);
+  const observation = {
+    question: mode === 'open-command' ? 'V5' : 'V1',
+    mode,
+    platform: process.platform,
+    editorVersion: vscode.version,
+    remoteName: vscode.env.remoteName ?? null,
+    caseExtensionHostPid: process.pid,
+    externalUriOfRedirect: await probe.externalUri(),
+    note: 'Extension-development window: VS Code shows no URI confirmation dialog here.',
+    attempts,
+    logs: await logLines(),
+  };
+  await writeFile(
+    path.join(process.env.BVE_EXTENSION_TEST_CONTROL_DIRECTORY!, 'probe-uri-observation.json'),
+    JSON.stringify(observation, null, 2) + '\n',
+  );
+  console.log('BVE_PROBE_OBSERVATION ' + JSON.stringify(observation));
+  if (mode !== 'open-command')
+    assert.equal(
+      attempts[0]?.deliveries,
+      1,
+      'The harness default reaches the handler once. ' + JSON.stringify(attempts),
+    );
+}
