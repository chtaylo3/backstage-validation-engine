@@ -0,0 +1,39 @@
+// OIDC PHASE 1 FEASIBILITY PROBE. THROWAWAY: never merge.
+// The product writes one SecretStorage value in a local window, reads it back, and sees its own
+// change event. The remote half of V4 is in the patched remote-session case.
+import assert from 'node:assert/strict';
+import { createHash, randomUUID } from 'node:crypto';
+import { writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import * as vscode from 'vscode';
+import { until } from '../fixture.js';
+import type { Fixture } from '../fixture.js';
+
+interface Probe {
+  storeSecret(value: string): Thenable<void>;
+  getSecret(): Thenable<string | undefined>;
+  secretChanges(): { key: string; at: number }[];
+}
+export async function run(fixture: Fixture): Promise<void> {
+  const probe = (fixture.api as unknown as { probe: Probe }).probe;
+  assert(probe, 'Run the probe build.');
+  const value = 'bve-probe-secret-' + randomUUID();
+  const before = probe.secretChanges().length;
+  await probe.storeSecret(value);
+  await until(() => probe.secretChanges().length > before, 'the change event of the stored secret');
+  const read = await probe.getSecret();
+  const observation = {
+    question: 'V4 (local half)',
+    platform: process.platform,
+    editorVersion: vscode.version,
+    storedSha256: createHash('sha256').update(value).digest('hex'),
+    readMatches: read === value,
+    changeEvents: probe.secretChanges().length - before,
+  };
+  await writeFile(
+    path.join(process.env.BVE_EXTENSION_TEST_CONTROL_DIRECTORY!, 'probe-secret-observation.json'),
+    JSON.stringify(observation, null, 2) + '\n',
+  );
+  console.log('BVE_PROBE_OBSERVATION ' + JSON.stringify(observation));
+  assert(observation.readMatches);
+}
