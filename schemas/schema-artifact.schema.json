{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:backstage-validation:schema-artifact:0.2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "version",
    "digest",
    "schema"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.2",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "schema": {
      "$ref": "urn:backstage-validation:json-value:0.2"
    }
  }
}
