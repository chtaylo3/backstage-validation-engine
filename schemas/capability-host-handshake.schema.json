{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "pluginId",
    "artifactDigest",
    "manifestDigest",
    "capabilities",
    "dependencies",
    "permissions",
    "executionProfile",
    "languageProfiles"
  ],
  "properties": {
    "apiVersion": {
      "const": "bve-plugin/1",
      "type": "string"
    },
    "pluginId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "artifactDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "manifestDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "capabilities": {
      "maxItems": 9,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "required",
          "inputSchemaDigest",
          "outputSchemaDigest",
          "mode"
        ],
        "properties": {
          "id": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "maximum": 1000,
            "type": "integer"
          },
          "required": {
            "type": "boolean"
          },
          "inputSchemaDigest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "outputSchemaDigest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "mode": {
            "anyOf": [
              {
                "const": "prepared",
                "type": "string"
              },
              {
                "const": "async",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "dependencies": {
      "maxItems": 64,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 4096,
        "type": "string"
      }
    },
    "permissions": {
      "maxItems": 2,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 4096,
        "type": "string"
      }
    },
    "executionProfile": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "languageProfiles": {
      "maxItems": 16,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 4096,
        "type": "string"
      }
    }
  },
  "$id": "urn:backstage-validation:capability:host-handshake:1",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
