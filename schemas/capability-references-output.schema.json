{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "references"
  ],
  "properties": {
    "references": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identity",
          "path"
        ],
        "properties": {
          "identity": {
            "pattern": "^[a-z][a-z0-9]{0,62}:[a-z0-9_.-]{1,63}/[a-z0-9_.-]{1,63}$",
            "type": "string"
          },
          "path": {
            "maxLength": 4096,
            "pattern": "^(?:/(?:[^~]|~[01])*)*$",
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "urn:backstage-validation:capability:references-output:1",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
