                          "required": [
                            "line",
                            "character"
                          ],
                          "properties": {
                            "line": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            },
                            "character": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            }
                          }
                        },
                        "end": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "line",
                            "character"
                          ],
                          "properties": {
                            "line": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            },
                            "character": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "transformation": {
                  "minLength": 1,
