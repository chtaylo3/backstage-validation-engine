                      "properties": {
                        "line": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        },
                        "character": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        }
                      }
                    }
                  }
