{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:backstage-validation:data-snapshot:0.2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contractVersion",
    "digest",
    "entries"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.2",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "key",
              "status",
              "value",
              "provenance"
            ],
            "properties": {
              "key": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "const": "present",
                "type": "string"
              },
              "value": {
                "$ref": "urn:backstage-validation:json-value:0.2"
              },
              "provenance": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "providerId",
                  "connectionId",
                  "installationId",
                  "principalId",
                  "permissionRevision",
                  "scope",
                  "revision",
                  "fetchedAt",
                  "expiresAt"
                ],
                "properties": {
                  "providerId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "connectionId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "installationId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "principalId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "permissionRevision": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "scope": {
                    "uniqueItems": true,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "revision": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "fetchedAt": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "expiresAt": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "key",
              "status",
              "provenance"
            ],
            "properties": {
              "key": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "const": "missing",
                "type": "string"
              },
              "provenance": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "providerId",
                  "connectionId",
                  "installationId",
                  "principalId",
                  "permissionRevision",
                  "scope",
                  "revision",
                  "fetchedAt",
                  "expiresAt"
                ],
                "properties": {
                  "providerId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "connectionId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "installationId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "principalId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "permissionRevision": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "scope": {
                    "uniqueItems": true,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "revision": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "fetchedAt": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "expiresAt": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "key",
              "status",
              "reason",
              "provenance"
            ],
            "properties": {
              "key": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "const": "unavailable",
                "type": "string"
              },
              "reason": {
                "anyOf": [
                  {
                    "const": "permission_denied",
                    "type": "string"
                  },
                  {
                    "const": "timeout",
                    "type": "string"
                  },
                  {
                    "const": "offline",
                    "type": "string"
                  },
                  {
                    "const": "provider_error",
                    "type": "string"
                  }
                ]
              },
              "provenance": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "providerId",
                  "connectionId",
                  "installationId",
                  "principalId",
                  "permissionRevision",
                  "scope",
                  "revision",
                  "fetchedAt",
                  "expiresAt"
                ],
                "properties": {
                  "providerId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "connectionId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "installationId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "principalId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "permissionRevision": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "scope": {
                    "uniqueItems": true,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "revision": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "fetchedAt": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "expiresAt": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
