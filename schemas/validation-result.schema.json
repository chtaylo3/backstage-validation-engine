{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:backstage-validation:validation-result:0.2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contractVersion",
    "run",
    "mode",
    "provenance",
    "outcome",
    "enforcement",
    "findings",
    "coverage",
    "artifacts",
    "ruleStates",
    "resources",
    "freshness"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.2",
      "type": "string"
    },
    "run": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "runId",
        "attemptId",
        "generation"
      ],
      "properties": {
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "attemptId": {
          "minLength": 1,
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      }
    },
    "mode": {
      "anyOf": [
        {
          "const": "ci",
          "type": "string"
        },
        {
          "const": "ide",
          "type": "string"
        }
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sourceDigest",
        "policyDigest",
        "profileDigest",
        "activationDigest",
        "dataDigest",
        "installationId",
        "repositoryId"
      ],
      "properties": {
        "sourceDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "baselineDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "policyDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "profileDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "activationDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "dataDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "installationId": {
          "minLength": 1,
          "type": "string"
        },
        "repositoryId": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "outcome": {
      "anyOf": [
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "incomplete",
          "type": "string"
        },
        {
          "const": "error",
          "type": "string"
        },
        {
          "const": "bypassed",
          "type": "string"
        }
      ]
    },
    "enforcement": {
      "anyOf": [
        {
          "const": "allow",
          "type": "string"
        },
        {
          "const": "block",
          "type": "string"
        },
        {
          "const": "advisory",
          "type": "string"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "ruleId",
          "ruleVersion",
          "subjectId",
          "message",
          "category",
          "severity",
          "enforcement",
          "location",
          "relatedLocations",
          "edits"
        ],
        "properties": {
          "id": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "ruleId": {
            "minLength": 1,
            "type": "string"
          },
          "ruleVersion": {
            "minLength": 1,
            "type": "string"
          },
          "subjectId": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "const": "input",
                "type": "string"
              },
              {
                "const": "compatibility",
                "type": "string"
              },
              {
                "const": "policy",
                "type": "string"
              },
              {
                "const": "configuration",
                "type": "string"
              },
              {
                "const": "dependency",
                "type": "string"
              },
              {
                "const": "resource",
                "type": "string"
              },
              {
                "const": "execution",
                "type": "string"
              }
            ]
          },
          "severity": {
            "anyOf": [
              {
                "const": "error",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              },
              {
                "const": "info",
                "type": "string"
              }
            ]
          },
          "enforcement": {
            "anyOf": [
              {
                "const": "blocking",
                "type": "string"
              },
              {
                "const": "advisory",
                "type": "string"
              },
              {
                "const": "bypassed",
                "type": "string"
              }
            ]
          },
          "location": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "uri",
              "document",
              "path",
              "range"
            ],
            "properties": {
              "uri": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$",
                "type": "string"
              },
              "document": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "range": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "line",
                      "character"
                    ],
                    "properties": {
                      "line": {
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      },
                      "character": {
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      }
                    }
                  },
                  "end": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "line",
                      "character"
                    ],
                    "properties": {
                      "line": {
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      },
                      "character": {
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "relatedLocations": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "uri",
                "document",
                "path",
                "range"
              ],
              "properties": {
                "uri": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$",
                  "type": "string"
                },
                "document": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "path": {
                  "type": "string"
                },
                "range": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "line",
                        "character"
                      ],
                      "properties": {
                        "line": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        },
                        "character": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        }
                      }
                    },
                    "end": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "line",
                        "character"
                      ],
                      "properties": {
                        "line": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        },
                        "character": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "edits": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "uri",
                "sourceDigest",
                "range",
                "text"
              ],
              "properties": {
                "uri": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$",
                  "type": "string"
                },
                "sourceDigest": {
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "version": {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "range": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "line",
                        "character"
                      ],
                      "properties": {
                        "line": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        },
                        "character": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        }
                      }
                    },
                    "end": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "line",
                        "character"
                      ],
                      "properties": {
                        "line": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        },
                        "character": {
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "urn:backstage-validation:coverage:0.2"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entityRef",
          "sourceUri",
          "document",
          "sourceDigest",
          "value",
          "provenance"
        ],
        "properties": {
          "entityRef": {
            "minLength": 1,
            "type": "string"
          },
          "sourceUri": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "document": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "sourceDigest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "value": {
            "$ref": "urn:backstage-validation:json-value:0.2"
          },
          "provenance": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "path",
                "origin",
                "transformation"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "origin": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "uri",
                    "document",
                    "path",
                    "range"
                  ],
                  "properties": {
                    "uri": {
                      "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$",
                      "type": "string"
                    },
                    "document": {
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "path": {
                      "type": "string"
                    },
                    "range": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "line",
                            "character"
                          ],
                          "properties": {
                            "line": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            },
                            "character": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            }
                          }
                        },
                        "end": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "line",
                            "character"
                          ],
                          "properties": {
                            "line": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            },
                            "character": {
                              "minimum": 0,
                              "maximum": 9007199254740991,
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "transformation": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ruleStates": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ruleId",
          "subjectId",
          "required",
          "status"
        ],
        "properties": {
          "ruleId": {
            "minLength": 1,
            "type": "string"
          },
          "subjectId": {
            "minLength": 1,
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "anyOf": [
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              },
              {
                "const": "not_applicable",
                "type": "string"
              },
              {
                "const": "blocked",
                "type": "string"
              },
              {
                "const": "invalid_policy",
                "type": "string"
              },
              {
                "const": "incomplete",
                "type": "string"
              },
              {
                "const": "error",
                "type": "string"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "const": "timeout",
                "type": "string"
              },
              {
                "const": "cancelled",
                "type": "string"
              },
              {
                "const": "queue_exhausted",
                "type": "string"
              },
              {
                "const": "resource_limit",
                "type": "string"
              },
              {
                "const": "worker_failure",
                "type": "string"
              },
              {
                "const": "dependency_unavailable",
                "type": "string"
              },
              {
                "const": "prerequisite_blocked",
                "type": "string"
              },
              {
                "const": "invalid_expression",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "bypass": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "recordId",
        "revision",
        "type",
        "installationId",
        "repositoryId",
        "reason",
        "ruleIds",
        "issuedAt",
        "expiresAt",
        "verifiedAt",
        "authority"
      ],
      "properties": {
        "recordId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "const": "emergency",
              "type": "string"
            },
            {
              "const": "exception",
              "type": "string"
            }
          ]
        },
        "installationId": {
          "minLength": 1,
          "type": "string"
        },
        "repositoryId": {
          "minLength": 1,
          "type": "string"
        },
        "entityScope": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "ruleIds": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "issuedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "expiresAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "verifiedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "authority": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "repository",
            "revision",
            "verifierId",
            "evidenceDigest"
          ],
          "properties": {
            "repository": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "type": "string"
            },
            "verifierId": {
              "minLength": 1,
              "type": "string"
            },
            "evidenceDigest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        }
      }
    },
    "resources": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "startedAt",
        "completedAt",
        "deadlineAt",
        "interrupted"
      ],
      "properties": {
        "startedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "completedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "deadlineAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "interrupted": {
          "anyOf": [
            {
              "const": "none",
              "type": "string"
            },
            {
              "const": "timeout",
              "type": "string"
            },
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "const": "resource_limit",
              "type": "string"
            },
            {
              "const": "worker_failure",
              "type": "string"
            }
          ]
        }
      }
    },
    "freshness": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "evaluatedAt",
        "authorityCheckedAt",
        "publishBefore"
      ],
      "properties": {
        "evaluatedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "authorityCheckedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "publishBefore": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      }
    }
  }
}
