{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "changes",
    "reset",
    "coverage",
    "observedAt"
  ],
  "properties": {
    "changes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "key"
        ],
        "properties": {
          "kind": {
            "anyOf": [
              {
                "const": "entity",
                "type": "string"
              },
              {
                "const": "query",
                "type": "string"
              },
              {
                "const": "collection",
                "type": "string"
              },
              {
                "const": "authority",
                "type": "string"
              }
            ]
          },
          "key": {
            "minLength": 1,
            "maxLength": 4096,
            "type": "string"
          }
        }
      }
    },
    "cursor": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "reset": {
      "type": "boolean"
    },
    "coverage": {
      "const": "hints",
      "type": "string"
    },
    "observedAt": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "$id": "urn:backstage-validation:capability:dependency-changes-output:1",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
