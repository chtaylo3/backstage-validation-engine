{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "path",
    "value",
    "defaultKind",
    "namespace"
  ],
  "properties": {
    "path": {
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)*$",
      "type": "string"
    },
    "value": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "defaultKind": {
      "minLength": 1,
      "maxLength": 63,
      "type": "string"
    },
    "namespace": {
      "minLength": 1,
      "maxLength": 63,
      "type": "string"
    }
  },
  "$id": "urn:backstage-validation:capability:references-input:1",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
