{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:backstage-validation:policy-bundle:0.2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "revision",
    "extends",
    "rules",
    "schemas",
    "plugins"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.2",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    },
    "extends": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
      }
    },
    "rules": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "version",
              "mandatory",
              "severity",
              "requires",
              "kind",
              "expression"
            ],
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              },
              "mandatory": {
                "type": "boolean"
              },
              "severity": {
                "anyOf": [
                  {
                    "const": "error",
                    "type": "string"
                  },
                  {
                    "const": "warning",
                    "type": "string"
                  }
                ]
              },
              "requires": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "selector": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "kind": {
                "const": "cel",
                "type": "string"
              },
              "expression": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "version",
              "mandatory",
              "severity",
              "requires",
              "kind",
              "schema"
            ],
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              },
              "mandatory": {
                "type": "boolean"
              },
              "severity": {
                "anyOf": [
                  {
                    "const": "error",
                    "type": "string"
                  },
                  {
                    "const": "warning",
                    "type": "string"
                  }
                ]
              },
              "requires": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "selector": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "kind": {
                "const": "schema",
                "type": "string"
              },
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "id",
                  "version",
                  "digest"
                ],
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "digest": {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "digest"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "digest"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          }
        }
      }
    }
  }
}
